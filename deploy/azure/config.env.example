# Copy to deploy/azure/config.env and fill in. config.env is gitignored.
# Values left empty are generated on the first run and written back here,
# so later runs reuse them (do NOT delete this file after deploying).

# --- Azure location / naming ---
# If you get "RequestDisallowedByAzure" (common on Azure for Students),
# try another region: eastus, eastus2, centralus, westus2, brazilsouth...
LOCATION=eastus2
RESOURCE_GROUP=rg-telematics-pqrs
# Short lowercase prefix for resource names (letters/digits only)
PREFIX=telpqrs

# --- Required secrets ---
GROQ_API_KEY=

# Initial ADMIN user for auth-service (seeded after deploy)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Auto-generated if empty ---
SUFFIX=
JWT_SECRET=
PG_ADMIN_USER=pgadmin
PG_ADMIN_PASSWORD=
