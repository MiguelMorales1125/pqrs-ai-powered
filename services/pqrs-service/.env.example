# PQRS Domain Microservice Environment Variables

# Server Configuration
PORT=8002
HOST=0.0.0.0

# Database Configuration (Database-per-service pattern: pqrs_db)
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/pqrs_db

# Enterprise Configuration (Dynamic Triage)
COMPANY_CATEGORIES="PETITION,COMPLAINT,CLAIM,SUGGESTION"
COMPANY_PRIORITIES="LOW,MEDIUM,HIGH,CRITICAL"
COMPANY_DEPARTMENTS="Technical Support,Billing,Customer Care,Legal,Logistics,Network Operations"

# AI Engine (Groq API)
GROQ_API_KEY=your_groq_api_key_here
